FROM node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends blender ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY character-pipeline/manual-builder ./character-pipeline/manual-builder
ENV WORKER_MODE=1
ENV BLENDER_BIN=/usr/bin/blender
ENV NODE_ENV=production
ENV PORT=10000
EXPOSE 10000
CMD ["node","character-pipeline/manual-builder/server.mjs"]
